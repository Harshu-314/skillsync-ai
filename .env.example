# .env.example
#
# Template for local environment configuration. Copy this file to
# `.env` and fill in real values for local development:
#
#   cp .env.example .env
#
# .env itself is gitignored and should never be committed — this
# example file is the one that's safe to commit, since it contains
# no real secrets.

# Which config class to load (see app/config.py: config_by_name).
# One of: development, testing, production
FLASK_ENV=development

# Secret key used by Flask for session signing. MUST be overridden
# with a long random value in production — the fallback in config.py
# is for local development only.
SECRET_KEY=dev-secret-key-change-me

# Database connection string. Defaults to a local SQLite file if not
# set (see config.py). Uncomment/edit if you want to point elsewhere.
# DATABASE_URL=sqlite:///skillsync.db

# Comma-separated list of allowed frontend origins for CORS.
# The React dev server typically runs on port 3000.
CORS_ORIGINS=http://localhost:3000

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG

# Port the Flask dev server listens on (used by run.py)
PORT=5000

# --- Reserved for future sprints (uncomment when needed) ---
# APIFY_API_TOKEN=
